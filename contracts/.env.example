# Alchemy API Key for Mainnet Archive Node
# Get your API key from https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Private key for deployments (optional, uses test mnemonic if not provided)
PRIVATE_KEY=your_private_key_here

# External contracts
SHOYU_BASHI=0xShoyuBashiAddress

# ROSE/USD Price Feeds (comma-separated for redundancy)
# For production: configure 3+ feeds for median aggregation and outlier resistance
# For testing: minimum 1 feed required
# Example: ROSE_USD_FEEDS=0xFeed1Address,0xFeed2Address,0xFeed3Address
ROSE_USD_FEEDS=0x47EFD60558012A64649c709b350f20C7a5f5e2Aa,0x666938f7FBC353227F98DA43C050C8252eBfC0f7

# Token price feed (for PaymasterVault)
TOKEN_USD_FEED=0xd29802275E41449f675A2650629fBB268D2Ab52d

# Price staleness threshold in seconds (default: 3600 = 1 hour)
PRICE_STALENESS_SECONDS=3600

# Distribution limits (ROSE units)
DAILY_LIMIT_ROSE=10000
PER_TX_LIMIT_ROSE=100
LIMITS_ENABLED=true

# --- PaymasterVault deployment (remote chain) ---
# Owner for PaymasterVault (no fallback)
PAYMASTER_VAULT_OWNER=0xVaultOwnerAddress
BLOCK_HEADER_REQUESTER=0xBlockHeaderRequesterAddress

# --- PaymasterVault upgrade ---
PAYMASTER_VAULT_PROXY=0xVaultProxyToUpgrade

# --- PaymasterVault configuration (post-deploy task) ---
# If not supplied via CLI, the task reads these values
# Use PAYMASTER_VAULT_PROXY for both upgrade and configure tasks

# Token configuration (optional; if not set, task defaults token to USDC-e address below)
PAYMASTER_VAULT_TOKEN=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0
PAYMASTER_VAULT_TOKEN_ENABLED=true
# Decimals required when setting min/max/daily values
PAYMASTER_VAULT_TOKEN_DECIMALS=6
# Whole-token amounts parsed with DECIMALS above
PAYMASTER_VAULT_TOKEN_MIN=10
PAYMASTER_VAULT_TOKEN_MAX=100000
PAYMASTER_VAULT_TOKEN_DAILY_LIMIT=50000
PAYMASTER_VAULT_BREAKER_ENABLED=true

# --- CrossChainPaymaster deployment ---
# Owner address
OWNER=0xOwnerAddress

# --- CrossChainPaymaster upgrade ---
# CrossChainPaymaster UUPS proxy address on Sapphire (used by upgrade and configure tasks)
PAYMASTER_SAPPHIRE_PROXY=0xPaymasterProxy
RUN_VALIDATION=true

# --- CrossChainPaymaster configuration (post-deploy task, Sapphire) ---
# If not supplied via CLI, the task reads these values
# Uses PAYMASTER_SAPPHIRE_PROXY defined above
# Source chain configuration (evaluated on Sapphire)
PAYMASTER_SAPPHIRE_SOURCE_CHAIN_ID=11155111
PAYMASTER_SAPPHIRE_CHAIN_ENABLED=true
PAYMASTER_SAPPHIRE_CONFIRMATIONS=0
PAYMASTER_SAPPHIRE_BLOCK_TIME=2
# Max per-tx amount in ROSE (ether units)
PAYMASTER_SAPPHIRE_MAX_ROSE=100
# Source vault address authorization
PAYMASTER_SAPPHIRE_AUTHORIZE_VAULT=true
# Global distribution limits (can reuse deployment defaults)
# DAILY_LIMIT_ROSE=10000
# PER_TX_LIMIT_ROSE=100
# LIMITS_ENABLED=true
